{
  "name": "actual-importer",
  "version": "0.1.0",
  "description": "CLI tool to import bank transactions from Polish banks into Actual Budget",
  "type": "module",
  "bin": {
    "actual-importer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "keywords": [
    "actual-budget",
    "bank-import",
    "cli",
    "ing",
    "erste"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@actual-app/api": "^26.11.0",
    "@clack/prompts": "^1.8.1",
    "csv-parse": "^7.0.3",
    "iconv-lite": "^0.7.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  }
}
