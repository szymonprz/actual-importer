# Copy to .env and fill in. .env is gitignored.
# Real environment variables take precedence over this file.
# Alternatively run `npx tsx src/cli.ts setup`, which can write this file for you.

# URL of your Actual server
ACTUAL_SERVER_URL=https://actual.example.com
# Password you use to log into Actual
ACTUAL_PASSWORD=
# Budget sync ID: Actual → Settings → Show advanced settings → Sync ID
ACTUAL_BUDGET_ID=
# Only if end-to-end encryption is enabled for the budget
ACTUAL_E2E_PASSWORD=

# Optional: where account mappings are stored (default ~/.actual-importer/config.json).
# Account mappings are added automatically the first time you import a new account.
# ACTUAL_IMPORTER_CONFIG=./actual-importer.json
